  ],
  "item": [
    {
      "name": "1. Auth - Iniciar Sesion (Token Automatico)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (jsonData && jsonData.idToken) {",
              "    pm.collectionVariables.set('idToken', jsonData.idToken);",
              "    console.log('Token guardado con exito:', jsonData.idToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"returnSecureToken\": true\n}"
        },
        "url": {
          "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}",
          "protocol": "https",
          "host": [
            "identitytoolkit",
            "googleapis",
            "com"
          ],
          "path": [
            "v1",
            "accounts:signInWithPassword"
          ],
          "query": [
            {
              "key": "key",
              "value": "{{firebaseApiKey}}"
            }
          ]
        }
      }
    },
    {
      "name": "2. Mascotas - Listar Mascotas (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "url": {
          "raw": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/pets",
          "protocol": "https",
          "host": [
            "firestore",
            "googleapis",
            "com"
          ],
          "path": [
            "v1",
            "projects",
            "{{projectId}}",
            "databases",
            "(default)",
            "documents",
            "pets"
          ]
        }
      }
    },
