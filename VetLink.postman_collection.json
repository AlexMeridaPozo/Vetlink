    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "firebaseApiKey",
      "value": "AIzaSyDiqLibp6p-BMAe9rOc46VMv6PKWQEtPOU",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "vetlink-bc8e2",
