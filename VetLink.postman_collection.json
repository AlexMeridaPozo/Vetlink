    },
    {
      "key": "idToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "usuario@ejemplo.com",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "password123",
