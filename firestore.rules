rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones de ayuda ──────────────────────────────────────────────────
    
    // Verifica si el usuario actual ha iniciado sesión
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario autenticado tiene el rol de Veterinario autorizado
    // Se valida consultando el documento del usuario en la colección 'users'
    function isVeterinario() {
      return isAuthenticated() && (
        request.auth.token.role == 'veterinario' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'veterinario')
      );
    }

    // Verifica si el usuario es el propietario registrado de la mascota
    function isOwner(petData) {
      return isAuthenticated() && (
        petData.userId == request.auth.uid ||
        petData.ownerId == request.auth.uid
      );
    }

    // ── Colección 'users' ───────────────────────────────────────────────────
    // Perfiles de usuario, credenciales y asignación de roles
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer perfiles (para validar veterinarios o tutores)
      allow read: if isAuthenticated();

      // Creación: El propio usuario puede crear su perfil
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Actualización: El propio usuario puede actualizar sus datos (incluyendo teléfono, datos profesionales, matrícula o rol)
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── Colección 'mascotas' ────────────────────────────────────────────────
    // Fuente de verdad de la información clínica y datos del animal
    match /mascotas/{petId} {
      // Lectura: Permitida para todos (incluso sin cuenta) para posibilitar el rescate inmediato por QR o NFC
      allow read: if true;

      // Creación: Veterinarios autorizados pueden dar de alta cualquier mascota.
      // Propietarios autenticados pueden registrar su propia mascota.
      allow create: if isAuthenticated() && (
        isVeterinario() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );

      // Actualización:
      // 1. Un veterinario puede actualizar cualquier campo (incluyendo datos clínicos y NFC).
      // 2. Un propietario/tutor solo puede actualizar sus propios datos de contacto y estado de extravío
      //    y NO puede modificar los campos técnicos de NFC (nfcTagId, nfcStatus, nfcLinkedBy, nfcLinkedAt).
      // 3. Un rescatista no autenticado puede actualizar ÚNICAMENTE el campo 'ultimoEscaneo' con su ubicación GPS.
      allow update: if (
        isAuthenticated() && (
          isVeterinario() ||
          (
            isOwner(resource.data) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nfcTagId', 'nfcStatus', 'nfcLinkedBy', 'nfcLinkedAt'])
          ) ||
          (
            (
              !('userId' in resource.data) || resource.data.userId == null || resource.data.userId == '' ||
              !('ownerId' in resource.data) || resource.data.ownerId == null || resource.data.ownerId == ''
            ) &&
            request.resource.data.userId == request.auth.uid
          )
        )
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoEscaneo'])
      );

      // Eliminación: Exclusiva para veterinarios autorizados
      allow delete: if isVeterinario();
    }

    // ── Colección 'escaneosRescate' ──────────────────────────────────────────
    // Registro de geolocalización y fecha de rescate generado al escanear la mascota
    match /escaneosRescate/{scanId} {
      allow create: if true; // Cualquier persona que encuentre a la mascota puede enviar su ubicación
      allow read: if isAuthenticated(); // Solo usuarios registrados (dueños/veterinarios) consultan el registro
    }

    // ── Colección 'nfcTags' ─────────────────────────────────────────────────
    // Asociación técnica entre etiquetas físicas NFC y mascotas
    match /nfcTags/{tagId} {
      // Lectura: Cualquier usuario autenticado puede resolver qué mascota corresponde a la etiqueta
      allow read: if isAuthenticated();

      // Escritura, Vinculación, Desvinculación y Reasignación:
      // ESTRICTAMENTE reservado para Veterinarios autorizados.
      // Un usuario común no tiene permitido alterar la vinculación de etiquetas NFC.
      allow create, update, delete: if isVeterinario();
    }

    // ── Colección 'consultasPublicas' (opcional) ─────────────────────────────
    // Si se expone una vista pública vía URL HTTPS, solo debe contener datos de identificación básicos
    match /consultasPublicas/{petId} {
      allow read: if true; // Datos públicos no sensibles (nombre, especie, teléfono de emergencia)
      allow write: if isVeterinario();
    }

    // ── Colección 'recordatorios' (US09) ────────────────────────────────────
    // Recordatorios de vacunas, controles y medicación para mascotas
    match /recordatorios/{recId} {
      // Lectura: Cualquier usuario autenticado
      allow read: if isAuthenticated();

      // Creación, Modificación y Eliminación: Usuarios autenticados (tutores y veterinarios)
      allow create, update, delete: if isAuthenticated();
    }

    // ── Colección 'turnos' ───────────────────────────────────────────────────
    // Citas médicas y turnos veterinarios (con bloqueo de doble reserva)
    match /turnos/{turnoId} {
      // Lectura: Cualquier usuario autenticado puede leer para consultar horarios ocupados de una clínica y sus propios turnos
      allow read: if isAuthenticated();

      // Creación: Cualquier usuario autenticado puede solicitar un turno
      allow create: if isAuthenticated();

      // Modificación, Cancelación y Atención Clínica: Titular del turno o profesional veterinario
      allow update, delete: if isAuthenticated();
    }
  }
}

